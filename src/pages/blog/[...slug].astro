---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import {
  loadProjectFromFilename,
  loadIdeaFromFilename,
  generateRelatedFilesOverview,
} from "src/project.type";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  seo={{
    title: post.data.title,
    description: post.data.description,
    canonical: post.data.seo?.canonical,
    noindex: post.data.seo?.noindex,
    nofollow: post.data.seo?.nofollow,
    openGraph: {
      basic: {
        title: post.data.title,
        image: post.data.seo?.openGraph?.basic?.image || '/assets/images/social-preview.png',
        type: 'article',
      },
      optional: {
        siteName: 'Jacob Experiments',
      },
      article: {
        publishedTime: post.data.date.toISOString(),
      },
    },
  }}
>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog"> Back to blog </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
      <div
        class="p-4 rounded-lg animate dark:border-white/50 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white"
      >
        <div
          set:html={generateRelatedFilesOverview(
            post.data.relatedIdeaFiles || [],
            "Related Ideas",
            "ideas",
            loadIdeaFromFilename
          )}
        />
        <div
          set:html={generateRelatedFilesOverview(
            post.data.relatedProjectFiles || [],
            "Related Projects",
            "projects",
            loadProjectFromFilename
          )}
        />
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
