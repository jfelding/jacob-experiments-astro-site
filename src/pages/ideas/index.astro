---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import IdeaBox from "@components/IdeaBox.astro";
import { IDEAS } from "@consts";
import type { Props as SEOProps } from "astro-seo";

const data = (await getCollection("ideas"))
  .filter((idea) => !idea.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"ideas">[];
};

const ideas = data.reduce((acc: Acc, idea) => {
  const date: Date = new Date(idea.data.date);
  const year = date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(idea);
  return acc;
}, {});

const years = Object.keys(ideas).sort((a, b) => parseInt(b) - parseInt(a));

const seo: SEOProps = {
  title: "Ideas - Jacob Experiments",
  description: "A collection of ideas, thoughts, and concepts that I'm exploring. Some are practical, some are just for fun.",
  openGraph: {
    basic: {
      title: "Ideas - Jacob Experiments",
      type: "website",
      image: "/assets/images/social-preview.png"
    }
  }
};
---
<PageLayout title={IDEAS.TITLE} description={IDEAS.DESCRIPTION} seo={seo}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Ideas
      </div>
      <div class="space-y-4">
        {
          years.map((year) => (
            <section class="animate space-y-4">
              <div class="font-semibold text-black dark:text-white">{year}</div>
              <div>
                <ul class="flex flex-col gap-4">
                  {ideas[year].map((idea) => (
                    <li>
                      <IdeaBox entry={idea} />
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
