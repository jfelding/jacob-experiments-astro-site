---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { IDEAS } from "@consts";
import IdeaBox from "@components/IdeaBox.astro";
import type { SEOProps } from "src/types";

const ideas = (await getCollection("ideas"))
  .filter((idea) => !idea.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const seo: SEOProps = {
  title: "Project Ideas and Thoughts - Jacob Experiments",
  description: "Loose thoughts and things I would like to explore. A collection of ideas and concepts for future projects.",
  openGraph: {
    basic: {
      title: "Project Ideas and Thoughts - Jacob Experiments",
      type: "website",
      image: "/assets/images/social-preview.png"
    }
  }
};
---
<PageLayout title={IDEAS.TITLE} description={IDEAS.DESCRIPTION} seo={seo}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">Ideas</div>
      <ul class="animate flex flex-col gap-4">
        {
          ideas.map((idea) => (
            <IdeaBox entry={idea} categories={idea.data.categories} />
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
