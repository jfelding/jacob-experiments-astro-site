---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { PROJECTS } from "@consts";
import ProjectArrowCard from "@components/ProjectArrowCard.astro";
import type { SEOProps } from "src/types";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const seo: SEOProps = {
  title: "Projects - Jacob Experiments",
  description: "A collection of my projects documenting my journey from concept to completion.",
  openGraph: {
    basic: {
      title: "Projects - Jacob Experiments",
      type: "website",
      image: "/assets/images/social-preview.png"
    }
  }
};

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION} seo={seo}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Projects
      </div>
      <ul class="animate flex flex-col gap-4">
        {
          projects.map((project) => (
            <li>
              <ProjectArrowCard
                entry={project}
                timeInvestmentRating={project.data.timeInvestmentRating || "medium"}
                necessityRating={project.data.necessityRating || "medium"}
                statusRating={project.data.statusRating || "in-progress"}
                categories={project.data.categories || []}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
