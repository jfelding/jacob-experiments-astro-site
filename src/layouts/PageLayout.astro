---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE_URL } from "@consts";
import { SEO } from "astro-seo";
import type { Props as SEOProps} from "astro-seo";
import "../styles/global.css";

// Props interface for PageLayout component
// Includes both basic page metadata an       d advanced SEO props
type Props = {
  title: string;
  description: string;
  seo?: SEOProps; 
};

// Destructure props with fallback for backward compatibility
const { title, description, seo } = Astro.props;

// Default SEO values that apply to all pages
const defaultSEO = {
  title: `${title} | Jacob Experiments`,
  description: description,
  canonical: `${SITE_URL}${Astro.url.pathname}`,
  openGraph: {
    basic: {
      title,
      type: 'website',
      image: '/assets/images/social-preview.png'
    },
    optional: {},
    image: {},
    article: {},
  },
  twitter: {
    creator: "@jacobexperiments"
  }
};

// Merge default SEO with provided SEO props (props override defaults)
const mergedSEO = {
  ...defaultSEO,
  ...seo,
  openGraph: {
    ...defaultSEO.openGraph,
    ...seo?.openGraph,
    basic: {
      ...defaultSEO.openGraph?.basic,
      ...seo?.openGraph?.basic,
    },
    optional: {
      ...defaultSEO.openGraph?.optional,
      ...seo?.openGraph?.optional,
    },
    image: {
      ...defaultSEO.openGraph?.image,
      ...seo?.openGraph?.image,
    },
    article: {
      ...defaultSEO.openGraph?.article,
      ...seo?.openGraph?.article,
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- SEO Implementation:
         - Always use the SEO component with merged default and custom SEO props
         - Default SEO values provide consistent baseline across all pages
         - Custom SEO props can override any default value when needed
    -->
    <SEO
      title={mergedSEO.title}
      description={mergedSEO.description}
      canonical={mergedSEO.canonical}
      noindex={mergedSEO.noindex}
      nofollow={mergedSEO.nofollow}
      openGraph={mergedSEO.openGraph as any}
      twitter={mergedSEO.twitter}
    />
    
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js">
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
